  "db_name": "PostgreSQL",
  "query": "\n            SELECT message_id, channel_id, key, user_id, created_at\n            FROM reaction\n            WHERE channel_id = $1\n              AND message_id = ANY($2)\n              AND deleted_seq IS NULL\n              AND ($3::uuid IS NULL OR (message_id, key, user_id) > ($3, $4, $5))\n            ORDER BY message_id, key, user_id\n            LIMIT $6\n            ",
