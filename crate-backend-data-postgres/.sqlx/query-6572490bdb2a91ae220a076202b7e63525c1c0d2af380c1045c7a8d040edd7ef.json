  "query": "\n            with r as (\n                select user_id, array_agg(role_id) as roles from role_member\n                join role on role.room_id = $1 and role_member.role_id = role.id\n                group by user_id\n            )\n        \tSELECT\n            \troom_id,\n            \tm.user_id,\n            \tmembership as \"membership: _\",\n            \toverride_name,\n            \toverride_description,\n            \tjoined_at,\n            \torigin,\n                mute,\n                deaf,\n                timeout_until,\n            \tcoalesce(r.roles, '{}') as \"roles!\",\n            \tquarantined\n            FROM room_member m\n            left join r on r.user_id = m.user_id\n            WHERE room_id = $1 AND m.user_id = $2 AND membership = 'Join'\n        ",
