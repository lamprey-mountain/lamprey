  "db_name": "PostgreSQL",
  "query": "\n            SELECT message_id, channel_id, key, user_id, created_at\n            FROM reaction\n            WHERE user_id = $1\n              AND deleted_seq IS NULL\n              AND ($2::uuid IS NULL OR message_id > $2 OR (message_id = $2 AND key > $3))\n            ORDER BY message_id, key\n            LIMIT $4\n            ",
