{
  "name": "@lamprey/openapi",
  "type": "module",
  "description": "automatically generated openapi types",
  "repository": {
    "type": "git",
    "url": "https://git.celery.eu.org/lamprey/lamprey"
  },
  "scripts": {
    "generate-schema-from-prod": "openapi-typescript https://chat.celery.eu.org/api/v1/openapi.json -o ./schema.d.ts",
    "generate-schema": "openapi-typescript http://localhost:4000/api/v1/openapi.json -o ./schema.d.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3"
  },
  "exports": "./mod.ts"
}
