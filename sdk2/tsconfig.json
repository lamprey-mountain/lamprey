{
	"$schema": "http://json.schemastore.org/tsconfig",
	"compilerOptions": {
		// features
		"lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Intl"],
		"target": "ES2023",
		"module": "ESNext",

		// bundler
		"moduleResolution": "bundler",
		"isolatedModules": true,

		// incremental builds
		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo",

		// linting
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"noPropertyAccessFromIndexSignature": true,

		// building
		"declaration": true,
		"outDir": "dist/",
		"baseUrl": "./"
		// "paths": {
		//   "@/*": ["./src/*"]
		// },
	},

	"include": ["src/**.ts"]

	// TODO: merge with ../tsconfig.json
	// "extends": "../tsconfig.json"
}
