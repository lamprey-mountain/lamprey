{
	"$schema": "http://json.schemastore.org/package",
	"name": "@lamprey/sdk",
	"type": "module",
	"version": "0.1.0",
	"description": "lamprey mountain sdk",
	"license": "MIT OR Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://git.celery.eu.org/lamprey/lamprey"
	},
	"exports": {
		".": {
			"default": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./uuid": {
			"default": "./dist/core/uuid.js",
			"types": "./dist/core/uuid.d.ts"
		}
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"generate-schema-from-prod": "openapi-typescript https://chat.celery.eu.org/api/docs.json -o ./schema.d.ts",
		"generate-schema": "openapi-typescript http://localhost:4000/api/docs.json -o ./schema.d.ts",
		"check": "tsc --noEmit",
		"build": "tsc"
	},
	"devDependencies": {
		"openapi-typescript": "^7.6.1",
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"idb": "^8.0.3",
		"msgpackr": "^1.11.9",
		"openapi-fetch": "^0.13.4",
		"uuidv7": "^1.0.2"
	}
}
